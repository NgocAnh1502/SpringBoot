<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Khai báo đường dẫn lưu file log -->
    <property name="LOG_PATH" value="logs" />
    <property name="LOG_FILE" value="${LOG_PATH}/application.log" />

    <!-- Định dạng hiển thị log -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />

    <!-- 1. Ghi log ra màn hình Console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 2. Ghi log ra File (Có cơ chế xoay vòng - Rolling) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Cắt file mỗi ngày. File cũ thêm hậu tố ngày tháng -->
            <fileNamePattern>${LOG_PATH}/application-%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Giữ log tối đa trong 30 ngày -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Root logger: Ghi tất cả log từ mức INFO trở lên ra cả Console và File -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>